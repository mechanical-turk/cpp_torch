{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "dev",
      "displayName": "Developer tooling",
      "description": "Debug build with tests and benchmarks for a complete clangd compilation database",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": true,
        "CPP_TORCH_BUILD_BENCHMARKS": true
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Ordinary Debug build with tests",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": true,
        "CPP_TORCH_BUILD_BENCHMARKS": false
      }
    },
    {
      "name": "strict",
      "displayName": "Strict diagnostics",
      "description": "Debug build with project warnings promoted to errors",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/strict",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": true,
        "CPP_TORCH_BUILD_BENCHMARKS": false,
        "CPP_TORCH_WARNINGS_AS_ERRORS": true
      }
    },
    {
      "name": "sanitized",
      "displayName": "ASan and UBSan",
      "description": "Debug build instrumented with AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/sanitized",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": true,
        "CPP_TORCH_BUILD_BENCHMARKS": false,
        "CPP_TORCH_ENABLE_SANITIZERS": true
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized library and example build without tests or benchmarks",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": false,
        "CPP_TORCH_BUILD_BENCHMARKS": false
      }
    },
    {
      "name": "benchmark",
      "displayName": "Release benchmarks",
      "description": "Optimized benchmark build without test targets",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/benchmark",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": false,
        "CPP_TORCH_BUILD_BENCHMARKS": true
      }
    },
    {
      "name": "no-tests",
      "displayName": "No tests",
      "description": "Debug library and example build with all test and benchmark targets disabled",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/no-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": false,
        "CPP_TORCH_BUILD_BENCHMARKS": false
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "strict",
      "configurePreset": "strict"
    },
    {
      "name": "sanitized",
      "configurePreset": "sanitized"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "benchmark",
      "configurePreset": "benchmark",
      "targets": [
        "cpp_torch_benchmarks"
      ]
    },
    {
      "name": "no-tests",
      "configurePreset": "no-tests"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "strict",
      "configurePreset": "strict",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitized",
      "configurePreset": "sanitized",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
